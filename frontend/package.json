  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "not IE 11"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "knip": "node scripts/knip.mjs",
    "test": "vitest run",
    "test:nightly": "vitest run --mode nightly",
    "test:bootstrap:browsers": "playwright test --config tests/browser/playwright.config.ts",
    "check": "node scripts/checks/run.mjs",
