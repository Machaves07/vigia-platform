# Finales de línea LF en el repositorio y en toda copia de trabajo, también en Windows con
# core.autocrlf=true: `uv.lock` y `openapi/app.yaml` se comparan byte a byte (NFR-NUC-52).
* text=auto eol=lf

# Precomprimidos de la aplicación de página única (y sus ejemplos de prueba): byte a byte.
*.br binary
*.gz binary

# Artefactos generados: plegados en las revisiones de GitHub.
backend/uv.lock linguist-generated=true
backend/openapi/** linguist-generated=true
backend/tools/vigia_verify.py linguist-generated=true

# Fuentes empaquetadas del documento del acta (TASK-217): byte a byte.
*.ttf binary
