# Entorno de la plataforma de integración (compose.integration.yml). Copia este archivo a
# `local/integration/.env` (los guiones lo leen solo) o pásalo con `--env-file`. Sin secretos:
# las contraseñas y claves las genera `init` en el volumen `estado` la primera vez.

# OBLIGATORIA. La IP de la tailnet de server-casa (`tailscale ip -4`): la única en la que escucha
# `vigia-mtls-edge`. Nunca 0.0.0.0. Para probar en un PC, 127.0.0.1.
VIGIA_EDGE_BIND=100.64.0.1

# Zona de nombres de `app.<zona>` (personas) y `nodes.<zona>` (nodos). Deben resolver a
# VIGIA_EDGE_BIND en cada cliente (MagicDNS de Tailscale o /etc/hosts). El certificado de servidor
# se emite una vez con estos nombres y esa IP: si cambian, borra el volumen `borde` y vuelve a
# repartir la raíz (README, «Confiar en la raíz del balanceador»).
VIGIA_DOMAIN=vigia.test

# Puertos del anfitrión de las dos escuchas (los de dentro del contenedor son 8443 y 8444). Van
# también en las URL que se entregan: `https://app.<zona>:<puerto>` (el origen de las personas se
# compara exacto) y `https://nodes.<zona>:<puerto>/api/nodes` (donde la alta manda latir al nodo).
VIGIA_EDGE_APP_PORT=8443
VIGIA_EDGE_NODES_PORT=8444

# La imagen de backend/Dockerfile, construida en esta máquina (ver el README).
VIGIA_PLATFORM_IMAGE=vigia-platform:integration

# Subred de la red interna. Cámbiala solo si choca con otra red de Docker del servidor.
VIGIA_INTERNAL_SUBNET=172.29.93.0/24
